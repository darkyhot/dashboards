# Контур (open|closed) задаётся в тетрадке run.ipynb через параметр contour=...,
# а не здесь. В .env — только ключи/URL.

# --- Открытый контур ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Локальный Postgres (docker-compose)
UZP_DB_URL=postgresql+psycopg2://uzp:uzp@localhost:55433/uzp

# --- Закрытый контур (заполняется в проде) ---
# UZP_CONTOUR=closed
# JPY_API_TOKEN=...
# GIGACHAT_API_URL=https://.../v1
# UZP_LLM_MODEL=glm-5.1            # или Qwen3.5-397b
# UZP_DB_URL=postgresql+psycopg2://user:pwd@prod-host:5432/dwh
